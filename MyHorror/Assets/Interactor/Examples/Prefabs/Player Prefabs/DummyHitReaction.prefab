--- !u!114 &8743188861395111387
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2023712170798638660}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1e36ebc0b8de90543a18645594dd9db3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  note: "HitReaction component:\n\nCreates realistic hit reactions by displacing body
    bones when struck. Automatically finds the closest bone to a hit point and applies
    customizable pull and release animations using Full Body IK Behaviour. \n\nCall
    Hit(hitPoint, hitDirection, hitForce) directly or use InteractorIK.TriggerHitReaction()
    as a wrapper method.\n\nTwo different showcases are calling it here: one is HitController
    on its child object HitPivot (which handles guitar hits), and the other is BasicGun
    in the scene."
