TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 112705681}
  m_Text: "ManuelButton\nThis is like half automated Touch, ends\nwhen effector bone
    reaches to its target\nbut starts with user input.\n\nWhen effector bone reaches
    it's target,\nit will call InteractorObject's events.\n\nAlso there is a buffer
    object on this named \nas Pivot, which rotates its forward releated\nto effector
    position when interaction starts.\n\nIf you enable PauseOnInteraction on InteractorObject,\ninteraction
    will pause when reached to target\nand will resume when used again."
  m_OffsetZ: 0
  m_CharacterSize: 6
  m_LineSpacing: 1.2
  m_Anchor: 4
  m_Alignment: 1
  m_TabSize: 4
  m_FontSize: 75
  m_FontStyle: 0
  m_RichText: 1
  m_Font: {fileID: 12800000, guid: 436664d726292a54fa79d2168f4541ac, type: 3}
