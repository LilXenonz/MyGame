--- !u!102 &1687755984
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1687755982}
  m_Text: "DistanceCrosshair\n\nThis is a regular interaction type\nused by most
    games. When\nplayer points it's crosshair on an\nobject, it gets ready to be
    used.\n\nDistance objects gets activated\nby Left Click.\n\nBecause of a different
    input, \nthey can be used with other\ninteractions since they use E key.\nSo
    it means you can open these \ndoors while holding pick up\nitems without dropping
    them etc."
  m_OffsetZ: 0
  m_CharacterSize: 6
  m_LineSpacing: 1.1
  m_Anchor: 1
  m_Alignment: 1
  m_TabSize: 4
  m_FontSize: 75
