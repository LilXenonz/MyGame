--- !u!102 &623033715
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 623033713}
  m_Text: 'Multiple MoveBody

    

    Tricycle and ProtoTruck uses

    multiple
    effectors all at once.

    

    It starts with Body effector.

    When
    it is in position and receives

    player input, it starts all other

    effectors
    including itself.

    

    LeftHand, RightHand, Body

    LeftFoot and RightFoot
    connect

    to their targets at the same time.

    Vice versa for disconnecting.

    

    Body
    target is required but you

    can use other effector targets

    if you
    wish to use.'
  m_OffsetZ: 0
  m_CharacterSize: 6
  m_LineSpacing: 1.1
  m_Anchor: 4
  m_Alignment: 1
  m_TabSize: 4
  m_FontSize: 75
  m_FontStyle: 0
