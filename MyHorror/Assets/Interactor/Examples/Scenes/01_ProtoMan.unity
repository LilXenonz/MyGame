--- !u!102 &1936596759
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1936596757}
  m_Text: "Maybe you don't want to interact with an object \ntoo close because your
    hand bones look weird for \nthat distance. Then you can override min and max
    \ndistances to go out of global Interactor rules on \nyour character.\r\n\r\nBut
    sometimes, a simpler solution can solve those \nissues better. #04 has a simple
    sphere collider on it, \nwhich prevents the player from coming closer from \nall
    angles and act like an invisible wall.\r\n\r\nAlso, the collider has physics
    material for making \nthe player slide smoothly."
  m_OffsetZ: 0
  m_CharacterSize: 5
  m_LineSpacing: 1.1
  m_Anchor: 4
  m_Alignment: 1
  m_TabSize: 4
  m_FontSize: 75
  m_FontStyle: 0
  m_RichText: 1
  m_Font: {fileID: 12800000, guid: 436664d726292a54fa79d2168f4541ac, type: 3}
  m_Color:
    serializedVersion: 2
    rgba: 4294967295
