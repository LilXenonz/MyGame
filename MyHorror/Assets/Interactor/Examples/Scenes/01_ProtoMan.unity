--- !u!102 &1273973362
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1273973360}
  m_Text: "So every interaction type pretty much work\nsame by putting some functions
    between\nthese events. \n\nObject is in trigger? Check it's targets for effector.\nTarget
    is in good position? Stay possible.\nUser input sent when possible? Start IK
    animation.\nAnimation started? Do X.\nAnimation on half? Do Y.\nY is done? Resume
    animation.\nAnimation is done? Do W.\nW is done? End interaction,\netc.\n\nIf
    all these seems a bit confusing, do not worry.\nInteractor deals with those.
    You just open \nSpawner Window and right click on objects to \nspawn new targets
    on SceneView.\nSelect interaction type and go."
  m_OffsetZ: 0
  m_CharacterSize: 6
  m_LineSpacing: 1.2
  m_Anchor: 7
  m_Alignment: 1
  m_TabSize: 4
  m_FontSize: 75
  m_FontStyle: 0
  m_RichText: 1
  m_Font: {fileID: 12800000, guid: 436664d726292a54fa79d2168f4541ac, type: 3}
  m_Color:
    serializedVersion: 2
    rgba: 4294967295
