--- !u!102 &1250736245
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1250736243}
  m_Text: 'On Debug view, every effector

    get their own colored lines. Lines

    show
    all InteractionObjects and their

    matched (same effector) targets.




    Opaque
    lines are possibles to interact

    while transparent fainted lines are

    out
    of position (not possible) targets.

    One bold bezier line shows selected

    object
    (by UI) for that effector.'
  m_OffsetZ: 0
  m_CharacterSize: 6
  m_LineSpacing: 1.1
  m_Anchor: 7
  m_Alignment: 1
  m_TabSize: 4
  m_FontSize: 75
