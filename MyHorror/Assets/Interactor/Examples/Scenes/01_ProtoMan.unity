  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 766560228}
  m_Text: "Gumball\n\nThis also has Rotator and uses \nmouse input to control.\n\nRotators
    are great because\nthey can be used for creative\nand easy but effective ways\nto
    create satisfying interactions.\n\nInstead of instantly using\na lever, pushing
    with mouse\ninput is much more fun \nand incentive gameplay."
  m_OffsetZ: 0
  m_CharacterSize: 6
