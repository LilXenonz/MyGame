TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 879573896}
  m_Text: "More Complex Interactions\n\nConsole has three middle (Rotators),\none
    left and one right (Switches)\ninteractions. \n\nNone of them lock player's position
    but\nRotators lock Camera Y axis because\nthey use Mouse Y axis as input.  When\nused,
    mouse controls their rotation.\n\nStart with OnOff button.\n"
  m_OffsetZ: 0
  m_CharacterSize: 6
  m_LineSpacing: 1.1
  m_Anchor: 1
  m_Alignment: 1
  m_TabSize: 4
  m_FontSize: 75
  m_FontStyle: 0
  m_RichText: 1
  m_Font: {fileID: 12800000, guid: 436664d726292a54fa79d2168f4541ac, type: 3}
  m_Color:
    serializedVersion: 2
    rgba: 4294967295
