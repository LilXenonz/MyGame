  m_GameObject: {fileID: 532671034}
  m_Text: "When SceneView toggle activated, you\ncan enable SceneView window.\n\r\nWith
    that, you can edit effectors without\n\rselecting Interactor, gizmos stay all
    the\ntime if you enable Debug option.\n\nDrag the SceneView window\r any place\nyou
    need. It works even if\r you work\nat fullscreen.\r SceneView window will \ngreatly
    improve \ryour workflow while\nediting effectors\r and spawning new targets.\r\n\r\nSceneView
    menu and button close\r automatically\nif you close \rInteractor Spawner Window."
  m_OffsetZ: 0
