--- !u!102 &675639041
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 675639039}
  m_Text: "IK starts the animation and\nmoves effector bone to target \n(0 -> 0.5
    of animation) and\nwhen reached, moves back to its\nstart position (0.5 -> 1)
    to end it.\n\nSo when IK animation is on half,\nit means the effector bone\nis
    at target's position.\n\nFor example, TouchStill\npauses IK animation on half
    to\nforce effector bone for staying\n on target. When effector check\nfails,
    it resumes the animation.\n\nSo move around these cubes\nto see when they interact."
  m_OffsetZ: 0
  m_CharacterSize: 6
  m_LineSpacing: 1.1
  m_Anchor: 7
  m_Alignment: 1
  m_TabSize: 4
  m_FontSize: 75
  m_FontStyle: 0
  m_RichText: 1
  m_Font: {fileID: 12800000, guid: 436664d726292a54fa79d2168f4541ac, type: 3}
  m_Color:
    serializedVersion: 2
    rgba: 4294967295
