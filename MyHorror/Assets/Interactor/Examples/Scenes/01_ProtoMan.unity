--- !u!102 &2147350913
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2147350911}
  m_Text: 'You can switch between Unity IK

    and Interactor Full Body IK (Not
    on Final IK version).


    You can switch between them at any time on Interactor.


    Unity
    IK will only control arms/hand or legs/foot. Full Body IK will

    control the
    whole body bones so it can pull towards when the

    targets are out of reach.'
  m_OffsetZ: 0
  m_CharacterSize: 6
