  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 888099360}
  m_Text: "Interaction objects get active and \nstart checking with matched effector\nwhen
    they're in your Sphere trigger.\nAll active interactions will show up \non your
    top left corner except Self\nInteractions. They are not selectable and\nthey
    get activated with given random odds.\nYou'll see them when character is in idle
    state."
  m_OffsetZ: 0
